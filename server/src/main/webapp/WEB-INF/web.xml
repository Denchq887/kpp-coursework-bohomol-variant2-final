<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>ecological-incidents-server</display-name>

    <servlet>
        <servlet-name>LocationServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.LocationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LocationServlet</servlet-name>
        <url-pattern>/locations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IncidentServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.IncidentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncidentServlet</servlet-name>
        <url-pattern>/incidents</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ObservationServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ObservationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ObservationServlet</servlet-name>
        <url-pattern>/observations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResponseMeasureServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ResponseMeasureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResponseMeasureServlet</servlet-name>
        <url-pattern>/measures</url-pattern>
    </servlet-mapping>

</web-app>
